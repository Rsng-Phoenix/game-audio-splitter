<!--
  Game Audio Splitter - window layout (WPF, Fluent / Windows 11 style).
  Loaded at runtime with XamlReader; %Tokens% are replaced with light/dark theme colours first.
  Embedded into the .exe by build.bat, so the app is still a single file.
  Motion rule: only short (<250 ms) transitions on user action. Nothing animates on its own,
  so the window costs ~0 CPU / GPU while idle.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game Audio Splitter" Width="460" Height="760" MinWidth="400" MinHeight="520"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14">
  <Window.Resources>
    <!-- ============ theme ============ -->
    <SolidColorBrush x:Key="bAccent" Color="%Accent%"/>
    <SolidColorBrush x:Key="bAccentHover" Color="%AccentHover%"/>
    <SolidColorBrush x:Key="bOnAccent" Color="%OnAccent%"/>
    <SolidColorBrush x:Key="bText1" Color="%Text1%"/>
    <SolidColorBrush x:Key="bText2" Color="%Text2%"/>
    <SolidColorBrush x:Key="bText3" Color="%Text3%"/>
    <SolidColorBrush x:Key="bCard" Color="%Card%"/>
    <SolidColorBrush x:Key="bCardStroke" Color="%CardStroke%"/>
    <SolidColorBrush x:Key="bCtrl" Color="%Ctrl%"/>
    <SolidColorBrush x:Key="bCtrlHover" Color="%CtrlHover%"/>
    <SolidColorBrush x:Key="bCtrlPressed" Color="%CtrlPressed%"/>
    <SolidColorBrush x:Key="bCtrlStroke" Color="%CtrlStroke%"/>
    <SolidColorBrush x:Key="bSegOn" Color="%SegOn%"/>
    <SolidColorBrush x:Key="bTrack" Color="%Track%"/>
    <SolidColorBrush x:Key="bMeterBg" Color="%MeterBg%"/>
    <SolidColorBrush x:Key="bThumbOuter" Color="%ThumbOuter%"/>
    <SolidColorBrush x:Key="bFlyout" Color="%Flyout%"/>
    <SolidColorBrush x:Key="bSwitchOff" Color="%SwitchOff%"/>
    <SolidColorBrush x:Key="bWarn" Color="%Warn%"/>
    <SolidColorBrush x:Key="bBad" Color="%Bad%"/>
    <SolidColorBrush x:Key="bGood" Color="%Good%"/>
    <SolidColorBrush x:Key="bIdle" Color="%Text3%"/>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <CubicEase x:Key="Ease" EasingMode="EaseOut"/>

    <!-- ============ text ============ -->
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="2,22,0,8"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource bText3}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource bText2}"/>
    </Style>

    <!-- ============ card ============ -->
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource bCard}"/>
      <Setter Property="BorderBrush" Value="{StaticResource bCardStroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="16,14"/>
    </Style>

    <!-- ============ minimal scrollbar ============ -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="3" Margin="1,2" Background="{StaticResource bTrack}"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ segmented control ============ -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource bText2}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Height="32">
              <Grid>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" TextElement.FontSize="13"/>
                <Border x:Name="bar" Width="16" Height="3" CornerRadius="1.5" Background="{StaticResource bAccent}"
                        VerticalAlignment="Bottom" Margin="0,0,0,2" RenderTransformOrigin="0.5,0.5" Opacity="0">
                  <Border.RenderTransform><ScaleTransform ScaleX="0.2"/></Border.RenderTransform>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource bCtrlHover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource bSegOn}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource bCtrlStroke}"/>
                <Setter Property="Foreground" Value="{StaticResource bText1}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="1" Duration="0:0:0.22" EasingFunction="{StaticResource Ease}"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                      <DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                       To="0.2" Duration="0:0:0.1"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ toggle switch ============ -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent" Width="40" Height="20">
              <Border x:Name="track" CornerRadius="10" BorderThickness="1" BorderBrush="{StaticResource bSwitchOff}" Background="{StaticResource bCtrl}"/>
              <Ellipse x:Name="thumb" Width="12" Height="12" Fill="{StaticResource bSwitchOff}" HorizontalAlignment="Left" Margin="4,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform X="0"/></Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource bCtrlHover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource bAccent}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource bAccent}"/>
                <Setter TargetName="thumb" Property="Fill" Value="{StaticResource bOnAccent}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                       To="20" Duration="0:0:0.16" EasingFunction="{StaticResource Ease}"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                       To="0" Duration="0:0:0.16" EasingFunction="{StaticResource Ease}"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ slider ============ -->
    <Style x:Key="Rail" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent">
              <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Knob" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid Width="20" Height="20" Background="Transparent">
              <Ellipse Fill="{StaticResource bThumbOuter}" Stroke="{StaticResource bCtrlStroke}" StrokeThickness="1"/>
              <Ellipse x:Name="dot" Fill="{StaticResource bAccent}" RenderTransformOrigin="0.5,0.5" Width="12" Height="12">
                <Ellipse.RenderTransform><ScaleTransform x:Name="sc" ScaleX="0.84" ScaleY="0.84"/></Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.1" Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.1" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.84" Duration="0:0:0.12"/>
                      <DoubleAnimation Storyboard.TargetName="dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.84" Duration="0:0:0.12"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="dot" Property="Width" Value="10"/>
                <Setter TargetName="dot" Property="Height" Value="10"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- volume-style: filled from the left -->
    <Style x:Key="FluentSlider" TargetType="Slider">
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="24" Background="Transparent">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Rail}" Background="{StaticResource bAccent}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Rail}" Background="{StaticResource bTrack}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource Knob}"/></Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- balance-style: neutral rail with a centre notch -->
    <Style x:Key="BalanceSlider" TargetType="Slider">
      <Setter Property="IsMoveToPointEnabled" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="24" Background="Transparent">
              <Border Width="2" Height="10" CornerRadius="1" Background="{StaticResource bTrack}" HorizontalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Rail}" Background="{StaticResource bTrack}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Rail}" Background="{StaticResource bTrack}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource Knob}"/></Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ buttons ============ -->
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource bOnAccent}"/>
      <Setter Property="Background" Value="{StaticResource bAccent}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Height="40" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{StaticResource bCtrlStroke}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="SemiBold"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource bAccentHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Secondary" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource bText1}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Height="40" CornerRadius="6" Background="{StaticResource bCtrl}" BorderBrush="{StaticResource bCtrlStroke}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="SemiBold"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource bCtrlHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource bCtrlPressed}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MuteToggle" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{StaticResource bText2}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="ToolTip" Value="Mute this output"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bd" Width="28" Height="28" CornerRadius="5" Background="Transparent">
              <TextBlock x:Name="glyph" Text="&#xE767;" FontFamily="{StaticResource Icons}" FontSize="15"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource bCtrlHover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource bCtrlPressed}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="glyph" Property="Text" Value="&#xE74F;"/>
                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource bBad}"/>
                <Setter Property="ToolTip" Value="Unmute"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Disclosure" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{StaticResource bText1}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bd" Background="Transparent" CornerRadius="5" Padding="2,6">
              <Grid>
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                  TextElement.FontFamily="{StaticResource Display}" TextElement.FontWeight="SemiBold"/>
                <TextBlock x:Name="chev" Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource bText2}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                  <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                </TextBlock>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource bCtrlHover}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="chev" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.2" EasingFunction="{StaticResource Ease}"/>
                  </Storyboard></BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="chev" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.2" EasingFunction="{StaticResource Ease}"/>
                  </Storyboard></BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ combo box ============ -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="bd" Background="{StaticResource bCtrl}" BorderBrush="{StaticResource bCtrlStroke}" BorderThickness="1" CornerRadius="5">
              <TextBlock Text="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="{StaticResource bText2}"
                         HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource bCtrlHover}"/></Trigger>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource bCtrlPressed}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Combo" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource bText1}"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Style="{StaticResource ComboToggle}" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter IsHitTestVisible="False" Margin="12,0,36,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <TextBlock x:Name="placeholder" Text="{TemplateBinding Tag}" Visibility="Collapsed" IsHitTestVisible="False"
                         Margin="12,0,36,0" VerticalAlignment="Center" Foreground="{StaticResource bText3}"/>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"
                     VerticalOffset="-4" HorizontalOffset="-8"
                     IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Margin="8" Padding="4" CornerRadius="8" Background="{StaticResource bFlyout}" BorderBrush="{StaticResource bCtrlStroke}" BorderThickness="1"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="340">
                  <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="6" Direction="270" Opacity="0.32"/></Border.Effect>
                  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="SelectedItem" Value="{x:Null}"><Setter TargetName="placeholder" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ComboItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource bText1}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="bd" CornerRadius="4" Padding="12,8" Margin="0,1" Background="Transparent">
              <Grid>
                <Border x:Name="pill" Width="3" Height="16" CornerRadius="1.5" Background="{StaticResource bAccent}"
                        HorizontalAlignment="Left" Margin="-10,0,0,0" Visibility="Collapsed"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource bCtrl}"/>
                <Setter TargetName="pill" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource bCtrlHover}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============ data templates ============ -->
    <DataTemplate x:Key="AppItemTemplate">
      <!-- Grid with a star column: long names shorten with "..." instead of overflowing -->
      <Grid ToolTip="{Binding Name}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Width="20" Height="20" Margin="0,0,10,0">
          <TextBlock Text="&#xE737;" FontFamily="{StaticResource Icons}" FontSize="14" Foreground="{StaticResource bText3}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Image Source="{Binding Icon}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>
        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" Text="{Binding Note}" VerticalAlignment="Center" Margin="8,1,0,0" FontSize="12" Foreground="{StaticResource bText3}"/>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="SourceItemTemplate">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="15" Foreground="{StaticResource bText2}"
                   VerticalAlignment="Center" Margin="2,0,12,0"/>
        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="OutputTemplate">
      <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Icons}" FontSize="18" Foreground="{StaticResource bText2}"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
              <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" IsEnabled="{Binding CanEnable}"
                      VerticalAlignment="Center" ToolTip="Play the sound on this device too"/>
          </Grid>

          <TextBlock Text="{Binding Warning}" Foreground="{StaticResource bWarn}" FontSize="12" TextWrapping="Wrap" Margin="32,8,0,0"
                     Visibility="{Binding HasWarning, Converter={StaticResource BoolVis}}"/>

          <StackPanel x:Name="details" Margin="32,10,0,0" Visibility="{Binding Enabled, Converter={StaticResource BoolVis}}">
            <StackPanel.RenderTransform><TranslateTransform Y="0"/></StackPanel.RenderTransform>

            <Grid>
              <TextBlock Text="Device volume" Style="{StaticResource Label}"/>
              <TextBlock Text="{Binding VolumeText}" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="-6,2,0,0" IsEnabled="{Binding HasVolume}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <ToggleButton Style="{StaticResource MuteToggle}" IsChecked="{Binding Muted}" Margin="0,0,6,0"/>
              <Slider Grid.Column="1" Style="{StaticResource FluentSlider}" Tag="volume" Minimum="0" Maximum="100"
                      SmallChange="1" LargeChange="10" Value="{Binding Volume}" VerticalAlignment="Center"
                      ToolTip="Same as this device's volume in Windows. Double-click for 100%."/>
            </Grid>

            <Grid Margin="0,10,0,0">
              <TextBlock Text="Balance" Style="{StaticResource Label}"/>
              <TextBlock Text="{Binding BalanceText}" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,2,0,0" IsEnabled="{Binding HasVolume}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="L" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="2,0,10,0"/>
              <Slider Grid.Column="1" Style="{StaticResource BalanceSlider}" Tag="balance" Minimum="-100" Maximum="100"
                      SmallChange="1" LargeChange="10" Value="{Binding Balance}" VerticalAlignment="Center"
                      ToolTip="Double-click to centre"/>
              <TextBlock Grid.Column="2" Text="R" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>

            <Grid Margin="0,12,0,0" Visibility="{Binding ShowFollow, Converter={StaticResource BoolVis}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Follow main volume" FontSize="13"/>
                <TextBlock Text="Gets louder and quieter with your main output's volume keys." Style="{StaticResource Hint}" Margin="0,1,0,0"/>
              </StackPanel>
              <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding FollowMain}" VerticalAlignment="Center"/>
            </Grid>

            <!-- level meters: scaled with a render transform, so updates never trigger layout -->
            <StackPanel Margin="0,12,0,2">
              <Grid Height="3">
                <Border Background="{StaticResource bMeterBg}" CornerRadius="1.5"/>
                <Border Background="{StaticResource bAccent}" CornerRadius="1.5" RenderTransformOrigin="0,0.5">
                  <Border.RenderTransform><ScaleTransform ScaleX="{Binding MeterL}"/></Border.RenderTransform>
                </Border>
              </Grid>
              <Grid Height="3" Margin="0,3,0,0">
                <Border Background="{StaticResource bMeterBg}" CornerRadius="1.5"/>
                <Border Background="{StaticResource bAccent}" CornerRadius="1.5" RenderTransformOrigin="0,0.5">
                  <Border.RenderTransform><ScaleTransform ScaleX="{Binding MeterR}"/></Border.RenderTransform>
                </Border>
              </Grid>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Enabled}" Value="True">
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="details" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                <DoubleAnimation Storyboard.TargetName="details" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                 From="-6" To="0" Duration="0:0:0.24" EasingFunction="{StaticResource Ease}"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <!-- ================= layout ================= -->
  <Grid x:Name="Root" TextElement.Foreground="{StaticResource bText1}">
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- title bar (native caption buttons are drawn by Windows on the right) -->
    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
      <Image x:Name="AppIcon" Width="16" Height="16" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="Game Audio Splitter" FontSize="12" Foreground="{StaticResource bText2}" VerticalAlignment="Center"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="20,10,20,8">

        <!-- status -->
        <Border HorizontalAlignment="Left" CornerRadius="13" Padding="10,4,12,5" Background="{StaticResource bCtrl}"
                BorderBrush="{StaticResource bCardStroke}" BorderThickness="1">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="0,1,8,0"/>
            <TextBlock Text="{Binding StatusTitle}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Hint}" Margin="2,8,0,0"/>

        <!-- source -->
        <TextBlock Text="Copy sound from" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <Border Background="{StaticResource bCtrl}" BorderBrush="{StaticResource bCtrlStroke}" BorderThickness="1" CornerRadius="7" Padding="2">
              <UniformGrid Columns="2">
                <RadioButton Style="{StaticResource Seg}" Content="One app" GroupName="mode" IsChecked="{Binding AppMode}"/>
                <RadioButton Style="{StaticResource Seg}" Content="Whole device" GroupName="mode" IsChecked="{Binding DeviceMode}"/>
              </UniformGrid>
            </Border>
            <ComboBox x:Name="AppCombo" Style="{StaticResource Combo}" ItemContainerStyle="{StaticResource ComboItem}"
                      ItemTemplate="{StaticResource AppItemTemplate}" Tag="Pick an app (start it first)" Margin="0,12,0,0"
                      ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}"
                      Visibility="{Binding AppMode, Converter={StaticResource BoolVis}}"/>
            <ComboBox x:Name="SourceCombo" Style="{StaticResource Combo}" ItemContainerStyle="{StaticResource ComboItem}"
                      ItemTemplate="{StaticResource SourceItemTemplate}" Margin="0,12,0,0"
                      ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                      Visibility="{Binding DeviceMode, Converter={StaticResource BoolVis}}"/>
            <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Hint}" Margin="2,10,0,0"/>
          </StackPanel>
        </Border>

        <!-- outputs -->
        <TextBlock Text="Also play it on" Style="{StaticResource Section}" Margin="2,22,0,2"/>
        <TextBlock Text="Volume, balance and mute are each device's own Windows settings, so they always match the system."
                   Style="{StaticResource Hint}" Margin="2,0,0,10"/>
        <ItemsControl ItemsSource="{Binding Outputs}" ItemTemplate="{StaticResource OutputTemplate}" Focusable="False"/>
        <TextBlock Text="No output devices found. Plug one in and it appears here." Style="{StaticResource Hint}" Margin="2,0,0,8"
                   Visibility="{Binding NoOutputs, Converter={StaticResource BoolVis}}"/>
        <TextBlock Text="Bluetooth: use the &#8220;Headphones&#8221; device, not &#8220;Headset / Hands-Free&#8221; (that one is low-quality call audio)."
                   Style="{StaticResource Hint}" Margin="2,0,0,0" Visibility="{Binding HasHandsFree, Converter={StaticResource BoolVis}}"/>

        <!-- advanced -->
        <ToggleButton x:Name="AdvToggle" Style="{StaticResource Disclosure}" Content="Advanced" Margin="0,16,0,0"/>
        <Border Style="{StaticResource CardStyle}" Margin="0,6,0,8"
                Visibility="{Binding IsChecked, ElementName=AdvToggle, Converter={StaticResource BoolVis}}">
          <StackPanel>
            <Grid>
              <TextBlock Text="Buffer" Style="{StaticResource Label}"/>
              <TextBlock Text="{Binding BufferText}" Style="{StaticResource Label}" HorizontalAlignment="Right"/>
            </Grid>
            <Slider Style="{StaticResource FluentSlider}" Minimum="20" Maximum="200" SmallChange="5" LargeChange="10"
                    TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding BufferMs}" Margin="0,2,0,0"/>
            <TextBlock Text="Lower means less delay. Raise it if you hear crackles on the extra devices." Style="{StaticResource Hint}" Margin="0,4,0,0"/>
            <Border Height="1" Background="{StaticResource bCardStroke}" Margin="0,14"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Start when the app opens"/>
                <TextBlock Text="Begins copying as soon as Game Audio Splitter launches." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
              </StackPanel>
              <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding AutoStart}" VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- footer -->
    <Grid Grid.Row="2" Margin="20,10,20,20">
      <Button x:Name="StartButton" Style="{StaticResource Primary}" Visibility="{Binding NotRunning, Converter={StaticResource BoolVis}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,1,10,0"/>
          <TextBlock Text="Start" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button x:Name="StopButton" Style="{StaticResource Secondary}" Visibility="{Binding Running, Converter={StaticResource BoolVis}}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE71A;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,1,10,0"/>
          <TextBlock Text="Stop" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid>
  </Grid>
</Window>
